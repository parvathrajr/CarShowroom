# Optional: omit MONGO_URI to use a temporary in-memory database for demos.
MONGO_URI=mongodb://127.0.0.1:27017/luxora
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Required for administrator sign-in. Use a long, unique AUTH_SECRET in production.
ADMIN_EMAIL=admin@luxoramotors.com
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-a-long-random-secret
